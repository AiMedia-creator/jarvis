# Beispiel-Umgebung für Jarvis – KEINE echten Schlüssel eintragen und diese Datei nicht als .env einchecken.
# Echte Werte gehören in deine Shell (z. B. ~/.zshrc) oder in einen Secret-Store; Jarvis liest sie beim Start.
# Jede Einstellung geht auch als JARVIS_<NAME> oder in ~/.jarvis.json (siehe jarvis.example.json, Datei 0600).

# --- Gehirn: Modell und Anbieter -------------------------------------------------------------------------
# Auswahl (auch in der Oberfläche unter Command Center → Einstellungen):
#   opus | sonnet | haiku            -> Anthropic (Claude Opus 5.5 / Sonnet 5.5 / Haiku 5.5)
#   kimi | kimi-schnell | kimi-k3    -> Moonshot (kimi-k3.1-pro / kimi-k3.1-pro-highspeed / kimi-k3)
#   ollama                           -> lokales Modell aus JARVIS_OLLAMA_MODEL
JARVIS_MODEL=opus

# Anthropic (offizielle API, console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-DEIN_SCHLUESSEL
# nur für persönliche Schlüssel (sk-ant-usr-…):
# ANTHROPIC_WORKSPACE_ID=wrkspc_…

# Moonshot / Kimi (offizielle API, platform.kimi.ai → API Keys)
# MOONSHOT_API_KEY=DEIN_MOONSHOT_SCHLUESSEL
# MOONSHOT_BASE_URL=https://api.moonshot.ai/anthropic   # Standard; nur ändern, wenn Moonshot einen anderen Endpunkt nennt
# JARVIS_MOONSHOT_MODEL=kimi-k3.1-pro                    # überschreibt das Modell hinter „kimi“

# Ollama (lokal, kein Schlüssel nötig)
# JARVIS_OLLAMA_MODEL=NAME_AUS_ollama_list
# OLLAMA_HOST=http://127.0.0.1:11434

# Nebenaufgaben (Gremium, Tiefenrecherche, Cloud-Skills) laufen immer mit Claude; ohne Claude als Gehirn:
# JARVIS_CLAUDE_HILFSMODELL=sonnet

# --- Google Workspace (Gmail, Kalender, Drive, Sheets, Aufgaben, Kontakte) ---------------------------------
# Kein Schlüssel hier: einmalig `python -m jarvis --google-verbinden /pfad/client_secret.json` (OAuth, Desktop-App).
# Token liegt danach in ~/.jarvis/google_token.json (0600).

# --- Browser (browser-harness, steuert deinen echten Chrome) ---------------------------------------------
# JARVIS_BROWSER=an
# JARVIS_BROWSER_BEFEHL=/Users/DEIN_NAME/.local/bin/browser-harness-mcp   # nur falls nicht im PATH
